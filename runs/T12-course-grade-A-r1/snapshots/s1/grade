#!/usr/bin/env python3
import sys
import json
from decimal import Decimal, ROUND_HALF_UP

def main():
    try:
        data_str = sys.stdin.read()
        if not data_str.strip():
            sys.exit(2)
        try:
            data = json.loads(data_str)
        except json.JSONDecodeError:
            sys.exit(2)
        if not isinstance(data, dict):
            sys.exit(2)
        # Required keys
        required_keys = ['quizzes', 'homework', 'midterm', 'final']
        if not all(k in data for k in required_keys):
            sys.exit(2)
        quizzes = data['quizzes']
        homework = data['homework']
        midterm = data['midterm']
        final = data['final']
        # Validate quizzes
        if not isinstance(quizzes, list) or not quizzes:
            sys.exit(2)
        for q in quizzes:
            if type(q) is not int or not (0 <= q <= 100):
                sys.exit(2)
        # Validate homework
        if not isinstance(homework, list) or not homework:
            sys.exit(2)
        for hw in homework:
            if not isinstance(hw, dict):
                sys.exit(2)
            if 'score' not in hw or 'days_late' not in hw:
                sys.exit(2)
            score = hw['score']
            days_late = hw['days_late']
            if type(score) is not int or not (0 <= score <= 100):
                sys.exit(2)
            if type(days_late) is not int or days_late < 0:
                sys.exit(2)
        # Validate midterm and final
        if type(midterm) is not int or not (0 <= midterm <= 100):
            sys.exit(2)
        if type(final) is not int or not (0 <= final <= 100):
            sys.exit(2)
        # Compute quiz average
        quiz_scores = list(quizzes)
        if len(quiz_scores) >= 2:
            lowest = min(quiz_scores)
            quiz_scores.remove(lowest)
        quiz_avg = Decimal(sum(quiz_scores)) / Decimal(len(quiz_scores))
        # Compute homework average after penalty
        penalty_scores = []
        for hw in homework:
            score_dec = Decimal(hw['score'])
            days = hw['days_late']
            if days >= 5:
                penalty = Decimal(0)
            else:
                factor = Decimal('1') - Decimal('0.1') * Decimal(days)
                penalty = score_dec * factor
            penalty_scores.append(penalty)
        hw_avg = sum(penalty_scores) / Decimal(len(penalty_scores))
        midterm_dec = Decimal(midterm)
        final_dec = Decimal(final)
        weighted = (quiz_avg * Decimal('0.15') +
                    hw_avg * Decimal('0.25') +
                    midterm_dec * Decimal('0.25') +
                    final_dec * Decimal('0.35'))
        percent_dec = weighted.quantize(Decimal('0.1'), rounding=ROUND_HALF_UP)
        percent = float(percent_dec)
        # Determine letter grade
        if percent >= 90.0:
            letter = 'A'
        elif percent >= 86.0:
            letter = 'B+'
        elif percent >= 80.0:
            letter = 'B'
        elif percent >= 76.0:
            letter = 'C+'
        elif percent >= 70.0:
            letter = 'C'
        elif percent >= 60.0:
            letter = 'D'
        else:
            letter = 'F'
        output = {'percent': percent, 'letter': letter}
        json.dump(output, sys.stdout, separators=(',', ':'))
        sys.stdout.write('\n')
    except Exception:
        sys.exit(2)

if __name__ == '__main__':
    main()
