#!/usr/bin/env python3
import sys, json

def main():
    # Read entire stdin
    try:
        data = json.loads(sys.stdin.read())
    except Exception:
        sys.exit(2)
    # Must be an object
    if not isinstance(data, dict):
        sys.exit(2)
    # Required fields
    age = data.get("age")
    trips = data.get("trips")
    if age is None or trips is None:
        sys.exit(2)
    # Age validation
    if type(age) is not int or age < 0 or age > 120:
        sys.exit(2)
    # Trips validation
    if not isinstance(trips, list):
        sys.exit(2)
    prev_minute = -1
    adult_fares = []
    for trip in trips:
        if not isinstance(trip, dict):
            sys.exit(2)
        bm = trip.get("board_minute")
        fz = trip.get("from_zone")
        tz = trip.get("to_zone")
        if bm is None or fz is None or tz is None:
            sys.exit(2)
        if type(bm) is not int or type(fz) is not int or type(tz) is not int:
            sys.exit(2)
        if bm < 0 or bm > 1439:
            sys.exit(2)
        if fz < 1 or fz > 6 or tz < 1 or tz > 6:
            sys.exit(2)
        if bm < prev_minute:
            sys.exit(2)
        prev_minute = bm
        adult_fares.append(270 + 95 * abs(fz - tz))
    # Determine fare type and cap
    if age < 5:
        fare_type = "free"
    elif 5 <= age <= 15:
        fare_type = "child"
    elif 65 <= age <= 120:
        fare_type = "senior"
    else:
        fare_type = "adult"
    caps = {"adult": 1100, "child": 550, "senior": 440, "free": 0}
    cap = caps[fare_type]
    # Compute fares with transfer rules and cap
    fares_cents = []
    window_start = None
    running_total = 0
    for idx, trip in enumerate(trips):
        bm = trip["board_minute"]
        # Determine transfer
        transfer = False
        if window_start is not None and bm <= window_start + 90:
            transfer = True
        # Determine base fare for this trip
        if transfer:
            fare = 0
        else:
            if fare_type == "free":
                fare = 0
            elif fare_type == "adult":
                fare = adult_fares[idx]
            elif fare_type == "child":
                base = adult_fares[idx] * 50 // 100
                fare = (base // 5) * 5
            elif fare_type == "senior":
                base = adult_fares[idx] * 40 // 100
                fare = (base // 5) * 5
        # Apply cap
        if running_total >= cap:
            fare = 0
        else:
            if running_total + fare > cap:
                fare = cap - running_total
        fares_cents.append(fare)
        running_total += fare
        # If not a transfer, open new window
        if not transfer:
            window_start = bm
    total_cents = sum(fares_cents)
    out = {"fares_cents": fares_cents, "total_cents": total_cents}
    sys.stdout.write(json.dumps(out, separators=(',', ':')))

if __name__ == "__main__":
    main()
