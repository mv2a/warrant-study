#!/usr/bin/env python3
import sys
import json
from decimal import Decimal, ROUND_HALF_UP

def main():
    data = sys.stdin.read()
    try:
        request = json.loads(data)
    except json.JSONDecodeError:
        sys.exit(2)

    if not isinstance(request, dict):
        sys.exit(2)

    required = {'quizzes', 'homework', 'midterm', 'final'}
    if not required.issubset(request):
        sys.exit(2)

    quizzes = request['quizzes']
    homework = request['homework']
    midterm = request['midterm']
    final = request['final']

    if not isinstance(quizzes, list) or len(quizzes) == 0:
        sys.exit(2)

    for q in quizzes:
        if type(q) is not int or not (0 <= q <= 100):
            sys.exit(2)

    if not isinstance(homework, list) or len(homework) == 0:
        sys.exit(2)

    hw_scores = []
    for hw in homework:
        if not isinstance(hw, dict):
            sys.exit(2)
        if 'score' not in hw or 'days_late' not in hw:
            sys.exit(2)
        score = hw['score']
        days_late = hw['days_late']
        if type(score) is not int or not (0 <= score <= 100):
            sys.exit(2)
        if type(days_late) is not int or days_late < 0:
            sys.exit(2)
        if days_late >= 5:
            adjusted = Decimal(0)
        else:
            factor = Decimal('1') - Decimal('0.1') * Decimal(days_late)
            adjusted = Decimal(score) * factor
        hw_scores.append(adjusted)

    if type(midterm) is not int or not (0 <= midterm <= 100):
        sys.exit(2)
    if type(final) is not int or not (0 <= final <= 100):
        sys.exit(2)

    if len(quizzes) >= 2:
        sorted_quizzes = sorted(quizzes)
        quizzes_to_avg = sorted_quizzes[1:]
    else:
        quizzes_to_avg = quizzes

    quiz_avg = Decimal(sum(quizzes_to_avg)) / Decimal(len(quizzes_to_avg))
    hw_avg = sum(hw_scores) / Decimal(len(hw_scores))

    percent = (
        quiz_avg * Decimal('0.15')
        + hw_avg * Decimal('0.25')
        + Decimal(midterm) * Decimal('0.25')
        + Decimal(final) * Decimal('0.35')
    )
    percent = percent.quantize(Decimal('0.1'), rounding=ROUND_HALF_UP)

    if percent >= Decimal('90.0'):
        letter = 'A'
    elif percent >= Decimal('86.0'):
        letter = 'B+'
    elif percent >= Decimal('80.0'):
        letter = 'B'
    elif percent >= Decimal('76.0'):
        letter = 'C+'
    elif percent >= Decimal('70.0'):
        letter = 'C'
    elif percent >= Decimal('60.0'):
        letter = 'D'
    else:
        letter = 'F'

    out = {'percent': float(percent), 'letter': letter}
    json.dump(out, sys.stdout, separators=(',', ':'))
    sys.stdout.write('\n')

if __name__ == '__main__':
    main()
