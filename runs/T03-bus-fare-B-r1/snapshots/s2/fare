#!/usr/bin/env python3
import sys, json

def main():
    try:
        data = sys.stdin.read()
    except Exception:
        sys.exit(2)
    if not data:
        sys.exit(2)
    try:
        obj = json.loads(data)
    except json.JSONDecodeError:
        sys.exit(2)
    if not isinstance(obj, dict):
        sys.exit(2)
    if 'age' not in obj or 'trips' not in obj:
        sys.exit(2)
    age = obj['age']
    trips = obj['trips']
    if not isinstance(age, int) or isinstance(age, bool) or age < 0 or age > 120:
        sys.exit(2)
    if not isinstance(trips, list):
        sys.exit(2)
    validated_trips = []
    previous_board_minute = -1
    for trip in trips:
        if not isinstance(trip, dict):
            sys.exit(2)
        if 'board_minute' not in trip or 'from_zone' not in trip or 'to_zone' not in trip:
            sys.exit(2)
        bm = trip['board_minute']
        fz = trip['from_zone']
        tz = trip['to_zone']
        if not isinstance(bm, int) or isinstance(bm, bool) or not isinstance(fz, int) or isinstance(fz, bool) or not isinstance(tz, int) or isinstance(tz, bool):
            sys.exit(2)
        if bm < 0 or bm > 1439 or fz < 1 or fz > 6 or tz < 1 or tz > 6:
            sys.exit(2)
        if bm < previous_board_minute:
            sys.exit(2)
        previous_board_minute = bm
        validated_trips.append((bm, fz, tz))
    if age < 5:
        age_cat = 'free'
    elif 5 <= age <= 15:
        age_cat = 'child'
    elif 16 <= age <= 64:
        age_cat = 'adult'
    else:
        age_cat = 'senior'
    if age_cat == 'adult':
        cap = 1100
    elif age_cat == 'child':
        cap = 550
    elif age_cat == 'senior':
        cap = 440
    else:
        cap = 0
    fares_cents = []
    running_total = 0
    window_start = None
    for bm, fz, tz in validated_trips:
        if window_start is None:
            window_start = bm
            is_transfer = False
        else:
            if bm <= window_start + 90:
                is_transfer = True
            else:
                window_start = bm
                is_transfer = False
        if is_transfer:
            fare = 0
        else:
            zone_diff = abs(fz - tz)
            zone_fare = 270 + 95 * zone_diff
            if age_cat == 'free':
                fare = 0
            elif age_cat == 'adult':
                fare = zone_fare
            elif age_cat == 'child':
                fare = (zone_fare // 2) // 5 * 5
            elif age_cat == 'senior':
                fare = ((zone_fare * 2) // 5) // 5 * 5
            else:
                fare = 0
        if running_total >= cap:
            fare_cap = 0
        elif running_total + fare > cap:
            fare_cap = cap - running_total
        else:
            fare_cap = fare
        fares_cents.append(fare_cap)
        running_total += fare_cap
    total_cents = running_total
    output = {"fares_cents": fares_cents, "total_cents": total_cents}
    print(json.dumps(output))

if __name__ == "__main__":
    main()
