#!/usr/bin/env python3
"""Price one rider's bus trips for one day: one JSON object in, one JSON object out.

Exit status 0 on success, 2 for a refused request (nothing is written on standard output).
"""

import json
import sys

BASE_CENTS = 270  # an adult trip within one zone
PER_BOUNDARY_CENTS = 95  # added for each zone boundary crossed
LOWEST_ZONE, HIGHEST_ZONE = 1, 6
LAST_MINUTE = 1439
OLDEST = 120
TRANSFER_MINUTES = 90

# fare class: (percent of the adult fare, daily cap in cents)
CLASSES = {
    "free": (0, 0),
    "child": (50, 550),
    "adult": (100, 1100),
    "senior": (40, 440),
}


class Refused(Exception):
    pass


def whole(value, low, high, what):
    # bool is a subclass of int in Python, so compare types exactly.
    if type(value) is not int or not low <= value <= high:
        raise Refused(f"{what} must be a whole number from {low} to {high}")
    return value


def parse(text):
    try:
        request = json.loads(text)
    except (ValueError, RecursionError):
        raise Refused("the request is not JSON") from None
    if not isinstance(request, dict):
        raise Refused("the request must be a JSON object")
    for field in ("age", "trips"):
        if field not in request:
            raise Refused(f"the request has no {field}")
    age = whole(request["age"], 0, OLDEST, "age")
    if not isinstance(request["trips"], list):
        raise Refused("trips must be a list")
    trips = []
    for number, trip in enumerate(request["trips"], start=1):
        if not isinstance(trip, dict):
            raise Refused(f"trip {number} must be an object")
        for field in ("board_minute", "from_zone", "to_zone"):
            if field not in trip:
                raise Refused(f"trip {number} has no {field}")
        minute = whole(trip["board_minute"], 0, LAST_MINUTE, f"trip {number}: board_minute")
        start = whole(trip["from_zone"], LOWEST_ZONE, HIGHEST_ZONE, f"trip {number}: from_zone")
        end = whole(trip["to_zone"], LOWEST_ZONE, HIGHEST_ZONE, f"trip {number}: to_zone")
        if trips and minute < trips[-1][0]:
            raise Refused(f"trip {number} boards before the trip listed before it")
        trips.append((minute, start, end))
    return age, trips


def fare_class(age):
    if age < 5:
        return "free"
    if age <= 15:
        return "child"
    if age >= 65:
        return "senior"
    return "adult"


def concession(adult_cents, percent):
    return adult_cents * percent // 100  # whole cents, rounded down


def price(age, trips):
    percent, cap = CLASSES[fare_class(age)]
    fares, total, window_opened = [], 0, None
    for minute, start, end in trips:
        if window_opened is not None and minute - window_opened <= TRANSFER_MINUTES:
            fare = 0  # a transfer
        else:
            window_opened = minute
            fare = concession(BASE_CENTS + PER_BOUNDARY_CENTS * abs(end - start), percent)
        fare = min(fare, cap - total)
        fares.append(fare)
        total += fare
    return fares, total


def main():
    try:
        try:
            text = sys.stdin.buffer.read().decode("utf-8")
        except UnicodeDecodeError:
            raise Refused("the request is not UTF-8 text") from None
        age, trips = parse(text)
    except Refused as refusal:
        print(f"fare: refused: {refusal}", file=sys.stderr)
        return 2
    fares, total = price(age, trips)
    sys.stdout.write(json.dumps({"fares_cents": fares, "total_cents": total}) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
